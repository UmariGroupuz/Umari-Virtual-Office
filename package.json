{
  "name": "ai-virtual-office",
  "version": "0.1.0",
  "private": true,
  "description": "AI Virtual Office — real-time monitoring MVP for the AI development team (Phase 1).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev -w @vo/server",
    "dev:web": "npm run dev -w @vo/web",
    "build": "npm run typecheck && npm run build -w @vo/web",
    "start": "npm run start -w @vo/server",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:scripts": "node --test scripts/lib/processIdentity.test.mjs scripts/lib/devReaper.test.mjs scripts/lib/sourceWatcher.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:reset": "npm run db:reset -w @vo/server",
    "verify": "node scripts/verify.mjs",
    "smoke": "node scripts/smoke-live.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^10.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
